{
  "name": "uhd-student-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UHD Student Extension — Manifest V3 foundation.",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests vite.config.ts",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "build:watch": "vite build --watch",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/public-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
